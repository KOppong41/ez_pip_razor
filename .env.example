# Django/local API
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
API_ALLOW_OPEN=False
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (SQLite is intentionally unsupported)
DATABASE_URL=postgres://eztrade:replace-me@127.0.0.1:5432/eztrade

# Redis/Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Dedicated key for encrypted BrokerAccount passwords. Do not reuse DJANGO_SECRET_KEY.
BROKER_CREDS_KEY=

# External alert ingestion remains disabled in personal runtime.
EXTERNAL_ALERTS_ENABLED=False
ALERT_WEBHOOK_TOKEN=
ALERT_WEBHOOK_SECRET=
EXECUTION_ALERT_SECRET=

# Optional notifications
TV_IMAP_HOST=
TV_IMAP_PORT=993
TV_IMAP_USER=
TV_IMAP_PASSWORD=
TV_IMAP_FOLDER=INBOX
TV_ALLOWED_FROM=
TV_SUBJECT_CONTAINS=TradingView Alert
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Runtime safety
ALLOW_PAPER_BROKERS=True
ADMIN_DISABLE_MT5_LOGIN=True
MT5_MAGIC_NUMBER=20250813
MT5_MAX_TICK_AGE_SECONDS=120
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8000
