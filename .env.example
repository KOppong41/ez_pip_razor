# Copy to .env and replace every change-me value. Use strict KEY=VALUE syntax;
# labels such as "Client ID: ..." are not valid dotenv entries.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-use-a-long-random-value
ALLOWED_HOSTS=127.0.0.1,localhost
API_ALLOW_OPEN=False

DB_ENGINE=django.db.backends.postgresql
DB_NAME=ez_piprazor_db
DB_USER=postgres
DB_PASSWORD=change-me-database-password
DB_HOST=localhost
DB_PORT=5432
POSTGRES_PASSWORD=change-me-database-password

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
BROKER_CREDS_KEY=
RUNTIME_STOP_TOKEN_MAX_AGE_SECONDS=3600

# MT5 account credentials are encrypted and stored through the application;
# inactive cTrader credentials are not loaded by this release.
